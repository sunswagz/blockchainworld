# Kệ dụng cụ ĐƯỢC commit (.claude/skills/) — nó là mã nguồn dùng chung.
# Chỉ chặn thứ riêng của từng máy. Trước đây cả `.claude/` bị chặn ở
# .git/info/exclude, mà file đó KHÔNG theo repo: máy này không commit
# được kệ, runner thì commit được. Khai ở đây để mọi máy hiểu giống nhau.
.claude/worktrees/
.claude/settings.local.json
# Đề bài của vòng tiến hoá — chỉ sống trong một lượt chạy, thứ đáng
# giữ là những sửa đổi đã qua cổng chặn. Cùng lý do với de-bai.json
# và quet.json của Đài Quan Trắc.
ho-bo/assets/data/de-bai-tien-hoa.json
# Hai cung tiến hoá còn lại, cùng lý do. Thiếu chúng thì ai chạy vòng
# ở máy rồi `git add <cung>/` là commit nhầm một file bot — mà file đó
# sinh lại mỗi lượt nên nó chỉ tạo xung đột, không mang gì.
thai-boc-tu/assets/data/de-bai-tien-hoa.json
kham-thien-giam/assets/data/de-bai-tien-hoa.json

# Đề bài của vòng tiến hoá tri thức — chỉ sống trong một lượt chạy,
# thứ đáng giữ là dữ liệu đã qua cổng chặn. Cùng lý do với de-bai.json
# của Đài Quan Trắc và de-bai-tien-hoa.json của Hộ Bộ.
knowledge-os/data/de-bai-tien-hoa.json
