# Chép file này thành .env rồi điền khoá. .env đã nằm trong .gitignore.

# ── Bộ não ────────────────────────────────────────────────────────────────
# Không có khoá thì hệ thống VẪN CHẠY: brain tự rơi về chế độ "mock"
# (suy luận bằng luật, không tốn tiền). Mọi thứ khác — dữ liệu, chỉ báo,
# regime, risk engine, sàn, nhật ký — chạy y hệt.
ANTHROPIC_API_KEY=

# Ép chế độ brain: auto | claude | mock   (mặc định auto)
BRAIN=auto

# ── Sàn giao dịch ─────────────────────────────────────────────────────────
# Chỉ cần khi đặt "mode": "testnet" trong config.json.
#
# Lấy khoá: https://testnet.binance.vision → đăng nhập bằng GitHub →
#           "Generate HMAC_SHA256 Key". Khoá hiện ra ĐÚNG MỘT LẦN, chép ngay.
#
# Đây là TESTNET: sàn thật, khớp lệnh thật, số dư do Binance cấp và là tiền giả.
# Binance có thể xoá khoá và đặt lại số dư bất cứ lúc nào — đó là chuyện bình
# thường của testnet, không phải hỏng.
#
# Runtime không có đường nào chạm tới mainnet: base URL cắm cứng trong
# trader/exchange.py, không đọc từ config.
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
