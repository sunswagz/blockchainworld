  "chuaGan": [
   {
    "bai": "Bài 1 — Từ thu nhập tới tài sản tạo dòng tiền (mở đầu khoá học LP)",
    "ma": "tai-dau-tu-theo-quy-tac",
    "cau": "Lợi nhuận đã chốt chia ba: dự phòng · vốn nền · cơ hội tốt nhất; thị trường xấu thì về dự phòng; sụt vốn quá trần thì tắt lãi kép.",
    "ghi": "y tưởng snowball có kiểm soát — thuộc Trung Ương (Phân Bổ, Rủi Ro Tổng, cầu dao sụt vốn), không thuộc ty. Chưa có phép canh ở tầng ty."
   },
   {
    "bai": "Bài 2 — Four Scores (LP Scoreboard)",
    "ma": "luon-chua-von-trien-khai-duoc",
    "cau": "LUÔN giữ một phần vốn ở trạng thái triển khai được (deployable) và KHÔNG nạp tới mức bằng 0; nếu deployable = 0 thì bảng phải báo trạng thái 'không nhận cơ hội mới' thay vì cứ xếp hạng tiếp.",
    "ghi": "Vốn rảnh là của TRUNG ƯƠNG (`von_ranh()`), ty không được biết NAV. Buồng lái hiện «Vốn triển khai được» từ Trung Ương ở hàng chỉ số; nhưng chưa có luật nào đổi HÀNH ĐỘNG NGAY sang «không nhận cơ hội mới» khi vốn rảnh = 0 — nợ, đề xuất luật cấp hệ het-von-trien-khai."
   },
   {
    "bai": "Bài 3 — Financial Freedom (LP Freedom Ratio)",
    "ma": "khong-rut-song-khi-duoi-mot-ruoi",
    "cau": "KHI LP Freedom Ratio dưới 1.5, KHÔNG rút dòng tiền ra tiêu toàn bộ mà tái đầu tư phần dư; chỉ rút phần vượt khi tỉ lệ đã trên ngưỡng buffer.",
    "ghi": "Rút hay tái đầu tư là quyết định của NGƯỜI và của Trung Ương (Phân Bổ), ty không có phép canh; nấc thang 0,5/1/1,5/2 chỉ là NHÃN giai đoạn (`giaiDoanTuDo`) — chính tác giả nói không phải luật chuẩn, và mục khongLay của bài cũng bảo đừng biến thành điều kiện chặn tự động. Nợ: chính sách tái đầu tư ở Trung Ương."
   },
   {
    "bai": "Bài 3 — Financial Freedom (LP Freedom Ratio)",
    "ma": "dem-cong-van-hanh-truoc-khi-goi-thu-dong",
    "cau": "KHÔNG mô tả một vị thế concentrated liquidity là thu nhập thụ động cho tới khi đã đếm số lần ra ngoài dải và số lần can thiệp trong kỳ; nếu số can thiệp cao thì ghi nhận đây là công việc vận hành có chi phí.",
    "ghi": "Chưa có bộ đếm số lần ra ngoài dải và số lần can thiệp theo vị thế trong kỳ — cùng nợ với «uptime dải» ở Bài 2. `heSoDai` là núm quyết định tần suất, luật ngoai-dai bắt sự kiện, nhưng thước «bao nhiêu lần / kỳ, tốn bao nhiêu» chưa có."
   },
   {
    "bai": "Bài 4 — Why DeFi / DeFi Flywheel",
    "ma": "risk-checkpoint-truoc-tai-dau-tu",
    "cau": "KHÔNG compound lợi nhuận thẳng trở lại pool; LUÔN cho lợi nhuận đi qua risk engine rồi capital allocator, phân bổ theo tỉ lệ đã định trước (dự phòng / stable yield / LP tốt nhất / quỹ cơ hội).",
    "ghi": "Phân bổ lại lợi nhuận là việc của Trung Ương (Rủi Ro Tổng → Phân Bổ), cùng nợ với «tái đầu tư theo quy tắc» ở Bài 1. Ty chỉ cung cấp số để phân bổ (tachLoiNhuan, business); agent gắn ba luật chất lượng pool vào đây là lẫn hai tầng — bỏ."
   },
   {
    "bai": "Bài 6 — Keep Your Crypto Safe",
    "ma": "chia-tang-vi-gioi-han-thiet-hai",
    "cau": "LÀM: giữ phần lớn NAV ở ví kho (multi-sig/ví cứng, không duyệt dApp, không claim airdrop) và chỉ đẩy sang ví vận hành đúng phần vốn cho vị thế đang chạy; KHÔNG để một ví chứa đồng thời kho bạc và vốn thao tác.",
    "ghi": "Chia ví kho / ví vận hành là việc của NGƯỚI và Trung Ương; ty chỉ thấy MỘT địa chỉ ví được dán và không biết NAV. «Thiệt hại tối đa theo ví» chưa tính được — nợ, cùng họ với vốn rảnh cấp hệ."
   },
   {
    "bai": "Bài 7 — Lending & Staking",
    "ma": "kiem-thanh-khoan-rut-truoc-khi-tru-von",
    "cau": "LÀM: trước khi đưa vốn vào lending, đo available liquidity (tổng nạp trừ tổng vay) và KHÔNG trú vốn ở thị trường mà utilization cao tới mức không rút hết được phần dự định trong một lần.",
    "ghi": "Ty này không trú vốn ở lending — đó là ty tín dụng (`tin_dung/`) và Trung Ương; available liquidity của thị trường cho vay là số của ty ấy. Agent gắn tvl-mong/khongGiuKhoa là gượng — bỏ."
   },
   {
    "bai": "Bài 7 — Lending & Staking",
    "ma": "sieu-than-trong-khi-lst-lam-the-chap",
    "cau": "KHÔNG dùng LST làm tài sản thế chấp để vay rồi vào LP khi chưa mô phỏng health factor ở các mức depeg 1/3/5/10%; nếu mô phỏng cho ra thanh lý trong dải đó thì giảm đòn bẩy hoặc không vào.",
    "ghi": "Ngoài phạm vi ty: không LST, không vay, không health factor. Giữ làm ranh giới cho ngày Trung Ương có ty tín dụng làm việc này."
   },
   {
    "bai": "Bài 7 — Lending & Staking",
    "ma": "giu-dem-thanh-khoan-khong-ep-toi-uu-yield",
    "cau": "LÀM: luôn giữ phần vốn không sinh lời gồm gas reserve, vốn khẩn cấp, đệm rút và quỹ cơ hội; KHÔNG phân bổ 100% vốn vào các nhánh sinh yield dù chi phí cơ hội dương.",
    "ghi": "Dự phòng gas / khẩn cấp / đệm rút / quỹ cơ hội là cấp danh mục — Trung Ương (`von_ranh`, cầu dao); ty không biết NAV. Cùng nợ với «vốn rảnh cấp hệ» (Bài 2)."
   },
   {
    "bai": "Bài 8 — Liquidity Pools & Yield Farming",
    "ma": "canh-bao-mat-peg-stable",
    "cau": "KHI một đồng trong cặp ổn định lệch peg quá ngưỡng cảnh báo thì giảm vị thế, vượt ngưỡng nguy hiểm thì thoát; KHÔNG coi cặp stable là cặp an toàn mặc định.",
    "ghi": "Agent gắn gia-cu/sat-su-kien là gượng — hai luật ấy đọc tuổi giá và lịch sự kiện, không đọc neo. Ty chưa có NGUỒN giá USDG/USD (oracle hay pool USDG/USDT trên X Layer); USDG chỉ đứng trong chuỗi phụ thuộc với vai «mất neo là IL thật» và danh bạ bắt USDG giả. Ngưỡng 1%/2%/ngắt là điểm khởi đầu, phải soi lịch sử trước. Nợ. Trường liên quan: chuoiPhuThuoc, danhBaToken (kê ở đây, không gắn — gắn là bị tính đã có)."
   },
   {
    "bai": "Bài 8 — Liquidity Pools & Yield Farming",
    "ma": "khong-lp-khi-xu-huong-manh",
    "cau": "GIẢM hoặc KHÔNG mở vị thế LP hai chiều khi thị trường đang xu hướng một chiều mạnh; ưu tiên LP khi giá dao động trong biên.",
    "ghi": "Agent tự nhận gắn qua P(văng) là gần đúng, không phải bộ lọc regime — đúng, nên KHÔNG tính đã có. Bài 8 thêm thước `xuHuong` (z = lợi suất 20 phiên / σ·√(20/252); |z| > 2 là mạnh) vào biến động, CHỈ ĐO: chưa có luật đọc, vì chưa có mẫu cho thấy alpha LP âm ở chế độ mạnh trên chính pool này. Đo trước, canh sau. Trường liên quan: xuHuong (kê ở đây, không gắn — gắn là bị tính đã có)."
   }
  ],
