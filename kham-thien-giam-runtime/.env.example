# ═══════════════════════════════════════════════════════════════
# Khâm Thiên Giám — biến môi trường. Chép thành `.env` rồi điền.
# `.env` đã nằm trong .gitignore và PHẢI ở đó.
# ═══════════════════════════════════════════════════════════════

# ── Vòng não chậm (tuỳ chọn) ──────────────────────────────────
# Claude chỉ chạy ở vòng CHẬM: hậu kiểm, đề xuất giả thuyết, đọc
# lại băng. Nó KHÔNG nằm trong đường quyết định từng lệnh — xem
# mục "Ba làn tốc độ" trong README. Không có khoá thì runtime vẫn
# chạy đủ, chỉ mất phần nghiên cứu.
#
# Cùng nhóm với scripts/dich-skill.mjs: công cụ CHẠY TAY, ngoài
# vòng tự động. Đừng đưa runtime này vào bất kỳ GitHub Actions nào.
ANTHROPIC_API_KEY=

# ── Đặt lệnh thật (để trống nếu chưa chắc) ────────────────────
# CHỈ cần khi datLenh.choPhepLenhThat = true trong config.json.
# Không có khoá này thì lớp đặt lệnh tự rơi về sổ giấy — đó là
# mặc định, và là chỗ nên đứng cho tới khi băng ghi đủ dài để
# chạy lại và đo được net edge THẬT sau phí.
#
# Đây là khoá ví có tiền. Đừng dán vào chat, đừng commit, đừng
# đặt trên máy dùng chung.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
